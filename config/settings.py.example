        "name": "example-chat-model:latest",
        "options": {
            "num_ctx": 4096,
            "num_predict": 384,
            "temperature": 0.6,
            "repeat_penalty": 1.12,
            "reasoning": False,
            "description": "기본 모델"
        }
    },
    "alternate_model": {
        "name": "example-alt-model:demo",
        "options": {
