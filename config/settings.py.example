# 모델 설정값
# 추후 example 분리
import os

# 프로젝트 루트 경로 (자동 감지)
BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# 캐시 및 임시 파일 디렉터리 설정 (없으면 자동 생성, 프로젝트 루트 경로)
CACHE_DIR = os.path.join(BASE_DIR, "cache")
os.makedirs(CACHE_DIR, exist_ok=True)

# 기본 파일 내보내기 경로
EXPORT_DIR = os.path.join(BASE_DIR, "search_result")
os.makedirs(EXPORT_DIR, exist_ok=True)

# 검색 캐시 파일 경로
CACHE_FILE_PATH = os.path.join(CACHE_DIR, "search_cache.json")

# 파일 내보내기 경로
DEFAULT_EXPORT_PATH = os.path.join(EXPORT_DIR, "search_result.txt")

# 프롬프트 디렉터리 경로
PROMPTS_DIR = os.path.join(BASE_DIR, "prompts")
SYSTEM_PROMPTS_DIR = os.path.join(PROMPTS_DIR, "system")

# 모델명과 파라미터를 프로필 하나에서 함께 관리합니다.
# 아래 이름과 수치는 설정 형식 예시이며 실제 모델/권장값이 아닙니다.
MODEL_PROFILES = {
    "default_model": {
        "name": "example-chat-model:latest",
        "options": {
            "num_ctx": 4096,
            "num_predict": 384,
            "temperature": 0.6,
            "repeat_penalty": 1.12,
            "reasoning": False,
            "description": "기본 모델"
        }
    },
    "alternate_model": {
        "name": "example-alt-model:demo",
        "options": {
            "num_ctx": 6144,
            "num_predict": 256,
            "temperature": 0.35,
            "repeat_penalty": 1.08,
            "reasoning": False,
            "description": "대체 모델"
        }
    },
    "internal_router": {
        "name": "example-router-model:demo",
        "internal": True,
        "options": {
            "temperature": 0.15,
            "description": "라우터 및 대화 압축/요약 전용 모델"
        }
    }
}

# 기본 선택 프로필
DEFAULT_PROFILE = "default_model"
DEFAULT_SUB_PROFILE = "internal_router"