# 모델 설정값
# 추후 example 분리
import os

# 프로젝트 루트 경로 (자동 감지)
BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# 캐시 및 임시 파일 디렉터리 설정 (없으면 자동 생성, 프로젝트 루트 경로)
CACHE_DIR = os.path.join(BASE_DIR, "cache")
os.makedirs(CACHE_DIR, exist_ok=True)

# 기본 파일 내보내기 경로
EXPORT_DIR = os.path.join(BASE_DIR, "search_result")
os.makedirs(EXPORT_DIR, exist_ok=True)

# 검색 캐시 파일 경로
CACHE_FILE_PATH = os.path.join(CACHE_DIR, "search_cache.json")

# 파일 내보내기 경로
DEFAULT_EXPORT_PATH = os.path.join(EXPORT_DIR, "search_result.txt")

# 프롬프트 디렉터리 경로
PROMPTS_DIR = os.path.join(BASE_DIR, "prompts")

# 모델 풀 설정
AVAILABLE_MODELS = {
    "default": "모델명",
    "sub_model": "모델명"
}

CURRENT_MODEL = AVAILABLE_MODELS["default"]

# 모델별 최적 파라미터 매핑
MODEL_PROFILES = {
    "default_model": {
        "name": "모델명",
        "options": {
            "num_ctx": 16384,
            "num_predict": 1024,
            "temperature": 0.7,
            "description": "기본 모델"
        }
    },
    "sub_model": {
        "name": "모델명",
        "options": {
            "num_ctx": 16384,
            "num_predict": 1024,
            "temperature": 0.7,
            "description": "서브 모델"
        }
    }
}

# 기본 선택 프로필
DEFAULT_PROFILE = "default_model"